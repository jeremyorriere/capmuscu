---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { zones } from '../lib/data';

const goals = [
  { v: 'sante', l: 'Tonification & Santé' },
  { v: 'muscle', l: 'Prise de muscle' },
  { v: 'force', l: 'Force' },
];
const equipments = [
  { v: 'salle', l: 'Salle de sport' },
  { v: 'maison', l: 'Maison (haltères et petit matériel)' },
  { v: 'corps', l: 'Poids du corps uniquement' },
];
const durations = [
  { v: '30', l: '30 min' },
  { v: '45', l: '45 min' },
  { v: '60', l: '60 min' },
];
---
<Layout
  title="Créer ma séance de musculation en 10 secondes"
  description="Générez une séance de musculation équilibrée et réaliste selon votre objectif, vos muscles, votre matériel et votre durée. Machine prise ? Changez d'exercice en un clic."
>
  <Breadcrumb items={[{ name: 'Créer ma séance' }]} />
  <h1>Créer ma séance</h1>
  <p class="mt-3 max-w-3xl text-muted">Répondez à ces quatre questions pour obtenir une proposition. Vous pourrez remplacer un exercice ou ajuster la séance ensuite. Aucun compte n'est nécessaire.</p>

  <form id="form" class="mt-6 space-y-6" novalidate>
    <fieldset class="card">
      <legend class="text-xl font-extrabold px-2">1. Votre objectif</legend>
      <div class="grid gap-3 sm:grid-cols-3 mt-2">
        {goals.map((g, i) => <label class="choice"><input type="radio" name="goal" value={g.v} checked={i === 0} /><span>{g.l}</span></label>)}
      </div>
      <p class="mt-3 mb-0 text-sm text-muted">Pour reprendre en douceur ou débuter, gardez « Tonification & Santé ». Vous pouvez commencer sans expérience.</p>
    </fieldset>

    <fieldset class="card">
      <legend class="text-xl font-extrabold px-2">2. Que voulez-vous travailler ?</legend>
      <div class="grid gap-3 grid-cols-2 sm:grid-cols-4 mt-2" id="zones">
        <label class="choice col-span-2 sm:col-span-4"><input type="checkbox" id="z-all" value="" checked /><span>Séance complète (tout le corps)</span></label>
        {zones.map((z) => <label class="choice"><input type="checkbox" name="zone" value={z.slug} /><span>{z.name}</span></label>)}
      </div>
      <p class="text-sm text-muted mt-3 mb-0" id="zone-hint">Choisissez jusqu'à 3 zones.</p>
    </fieldset>

    <fieldset class="card">
      <legend class="text-xl font-extrabold px-2">3. Quel matériel avez-vous ?</legend>
      <div class="grid gap-3 sm:grid-cols-3 mt-2">
        {equipments.map((g, i) => <label class="choice"><input type="radio" name="equipment" value={g.v} checked={i === 0} /><span>{g.l}</span></label>)}
      </div>
    </fieldset>

    <fieldset class="card">
      <legend class="text-xl font-extrabold px-2">4. Combien de temps avez-vous ?</legend>
      <div class="grid gap-3 grid-cols-3 mt-2">
        {durations.map((g) => <label class="choice"><input type="radio" name="duration" value={g.v} checked={g.v === '45'} /><span>{g.l}</span></label>)}
      </div>
    </fieldset>

    <button type="submit" class="btn btn-accent w-full text-xl min-h-16">Générer ma séance</button>
  </form>

  <section id="result" class="mt-10 scroll-mt-4" aria-labelledby="result-title" hidden>
    <h2 id="result-title" tabindex="-1">Votre séance</h2>
    <p id="result-sub" class="text-muted mt-1"></p>
    <p id="live" class="sr-only" role="status" aria-live="polite"></p>
    <div class="session-bar">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p id="progress-text" class="m-0 font-extrabold">0 sur 0 exercices terminés</p>
        <button type="button" id="focus-toggle" class="btn" aria-pressed="false">Un exercice à la fois</button>
      </div>
      <div id="progress-bar" class="progress" role="progressbar" aria-label="Progression de la séance" aria-valuemin="0" aria-valuenow="0" aria-valuemax="1"><span id="progress-fill"></span></div>
    </div>
    <div id="toast" class="toast" aria-hidden="true"></div>
    <div id="rest-timer" class="rest-timer" role="timer" aria-label="Chronomètre de repos">
      <div class="rt-label" id="rt-label">Repos</div>
      <div class="rt-time" id="rt-time">0:00</div>
      <button type="button" id="rt-plus" aria-label="Ajouter 15 secondes">+15 s</button>
      <button type="button" id="rt-stop" aria-label="Arrêter le chronomètre">Stop</button>
    </div>
    <ol id="cards" class="mt-4 space-y-4 list-none p-0"></ol>
    <div id="focus-nav" class="focus-nav" hidden>
      <button type="button" id="f-prev" class="btn">← Précédent</button>
      <span id="f-pos" class="font-bold text-center"></span>
      <button type="button" id="f-next" class="btn btn-primary">Suivant →</button>
    </div>
    <div class="mt-6">
      <button type="button" id="finish" class="btn btn-accent w-full text-lg min-h-16">Terminer et ajouter à mon historique</button>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <button type="button" id="copy" class="btn">Copier ma séance</button>
      <button type="button" id="keep" class="btn btn-primary">Enregistrer cette séance</button>
      <button type="button" id="again" class="btn">Nouvelle séance</button>
    </div>
    <p id="msg" class="mt-3 font-bold text-accent" role="status" aria-live="polite"></p>
    <p class="card mt-3 text-muted">Votre séance en cours est sauvegardée automatiquement sur cet appareil. Elle rejoint votre historique uniquement après avoir choisi « Terminer ». Vous n'avez pas de compte et vos données ne sont pas envoyées au site. Pensez à <a class="link" href="/historique/#backup-title">exporter votre historique</a> avant de changer de téléphone ou de navigateur. En cas de douleur, arrêtez l'exercice.</p>
  </section>

  <section id="saved-section" class="mt-10" aria-labelledby="saved-title" hidden>
    <h2 id="saved-title">Mes modèles et séances enregistrées</h2>
    <p class="text-sm text-muted">Jusqu'à 10 modèles sur cet appareil. « Relancer » démarre une nouvelle séance sans effacer le modèle.</p>
    <ul id="saved" class="mt-4 space-y-3 list-none p-0"></ul>
  </section>

  <script>
    import exercisesJson from '../data/exercises.json';
    import musclesJson from '../data/muscles.json';
    import type { Duration, EquipmentMode, Exercise, Goal, Zone } from '../lib/types';
    import { canonicalEquipmentMode, createRng, generateSession, replaceExercise, sessionToText, targetMuscles } from '../lib/session';
    import type { SessionItem, SessionParams } from '../lib/session';
    import { restartTemplate } from '../lib/session-templates';
    import { motionHtml } from '../lib/motion';
    import { bodyMapSvg } from '../lib/bodymap';
    import { initMotion } from '../lib/motion-client';
    import { icon } from '../lib/icons';
    import { KEY_HISTORY, isEntry, mergeEntries } from '../lib/history';
    import type { HistoryEntry, SetDetail } from '../lib/history';
    import { muscleHue, tintStyle } from '../lib/ui';
    import { trackAnalytics } from '../lib/analytics';

    const openPeeks = new Set<number>();

    const exercises = exercisesJson as Exercise[];
    const zones = musclesJson.zones as Zone[];
    const GOAL_LABEL: Record<Goal, string> = { sante: 'Tonification & Santé', muscle: 'Prise de muscle', force: 'Force' };
    const KEY_CURRENT = 'capmuscu-seance-en-cours';
    const KEY_SAVED = 'capmuscu-seances-gardees';
    const KEY_LOADS = 'capmuscu-charges';
    const KEY_FOCUS = 'capmuscu-mode-pas-a-pas';

    interface State { params: SessionParams; items: SessionItem[]; createdAt: string; done?: boolean[]; sets?: number[]; weights?: number[]; setDetails?: SetDetail[][] }
    interface Saved extends State { id: string }

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = $<HTMLFormElement>('form');
    const allBox = $<HTMLInputElement>('z-all');
    const zoneBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="zone"]')];
    const rng = createRng(Date.now());
    let state: State | null = null;

    const load = <T,>(key: string): T | null => {
      try { const raw = localStorage.getItem(key); return raw ? (JSON.parse(raw) as T) : null; } catch { return null; }
    };
    const store = (key: string, value: unknown) => { try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch { return false; } };
    const say = (text: string) => { $('msg').textContent = text; };

    function checked(name: string, fallback: string) {
      return (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? fallback);
    }

    function readParams(): SessionParams {
      return {
        goal: checked('goal', 'sante') as Goal,
        zones: allBox.checked ? [] : zoneBoxes.filter((b) => b.checked).map((b) => b.value),
        equipment: canonicalEquipmentMode(checked('equipment', 'salle') as EquipmentMode),
        duration: Number(checked('duration', '45')) as Duration,
      };
    }

    function writeParams(p: SessionParams) {
      for (const [name, value] of [['goal', p.goal], ['equipment', p.equipment], ['duration', String(p.duration)]] as const) {
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
        if (input) input.checked = true;
      }
      allBox.checked = p.zones.length === 0;
      for (const b of zoneBoxes) b.checked = p.zones.includes(b.value);
      updateZoneState();
    }

    function updateZoneState() {
      const n = zoneBoxes.filter((b) => b.checked).length;
      for (const b of zoneBoxes) b.disabled = !b.checked && n >= 3;
      $('zone-hint').textContent = allBox.checked ? 'Séance complète : tout le corps est travaillé.' : n >= 3 ? 'Maximum atteint : 3 zones.' : "Choisissez jusqu'à 3 zones.";
    }

    allBox.addEventListener('change', () => {
      if (allBox.checked) for (const b of zoneBoxes) b.checked = false;
      else if (zoneBoxes.every((b) => !b.checked)) allBox.checked = true;
      updateZoneState();
    });
    for (const b of zoneBoxes) {
      b.addEventListener('change', () => {
        if (b.checked) allBox.checked = false;
        else if (zoneBoxes.every((x) => !x.checked)) allBox.checked = true;
        updateZoneState();
      });
    }

    function titleOf(p: SessionParams) {
      const zoneNames = p.zones.length === 0 ? 'Corps entier' : zones.filter((z) => p.zones.includes(z.slug)).map((z) => z.name).join(' + ');
      return `Séance ${GOAL_LABEL[p.goal]} — ${zoneNames} (${p.duration} min)`;
    }

    function render(animateIndex = -1) {
      if (!state) return;
      const { params, items } = state;
      $('result').hidden = false;
      $('result-sub').textContent = titleOf(params);
      const list = $('cards');
      list.replaceChildren();
      items.forEach((item, index) => {
        const ex = exercises.find((e) => e.id === item.exerciseId);
        if (!ex) return;
        const li = document.createElement('li');
        li.className = 'card ex-card';
        if (state?.done?.[index]) li.classList.add('is-done');
        if (index === animateIndex) li.classList.add('swap-in');

        const head = document.createElement('div');
        head.className = 'flex flex-wrap items-start justify-between gap-2';
        const h = document.createElement('h3');
        h.className = 'text-xl';
        const a = document.createElement('a');
        a.href = `/exercices/${ex.slug}/`;
        a.className = 'text-ink hover:underline';
        a.style.textDecoration = 'none';
        a.textContent = `${index + 1}. ${ex.name}`;
        h.append(a);
        const badge = document.createElement('span');
        badge.className = 'badge tint';
        badge.setAttribute('style', tintStyle(muscleHue(ex.primaryMuscle)));
        badge.textContent = `Muscle ciblé : ${ex.primaryMuscle}`;
        head.append(h, badge);

        const dl = document.createElement('dl');
        dl.className = 'pills';
        for (const [label, value, unit] of [['Séries', String(item.sets), ''], ['Répétitions', item.reps, ''], ['Repos', String(item.restSeconds), ' s']]) {
          const box = document.createElement('div');
          box.className = 'pill';
          const dt = document.createElement('dt');
          dt.textContent = label!;
          const dd = document.createElement('dd');
          if (label === 'Séries') {
            dd.className = 'set-adjustments';
            const adjust = (delta: number) => {
              if (!state) return;
              const previousTotal = item.sets;
              const nextTotal = Math.min(10, Math.max(1, previousTotal + delta));
              if (nextTotal === previousTotal) return;
              item.sets = nextTotal;
              state.sets = state.sets ?? [];
              state.done = state.done ?? [];
              const completed = Math.min(state.sets[index] ?? (state.done[index] ? previousTotal : 0), nextTotal);
              state.sets[index] = completed;
              state.done[index] = completed >= nextTotal;
              persist();
              render(index);
              const focusDelta = nextTotal === 1 ? 1 : nextTotal === 10 ? -1 : delta;
              document.querySelectorAll<HTMLElement>('#cards > li')[index]
                ?.querySelector<HTMLButtonElement>(`[data-set-adjust="${focusDelta}"]`)?.focus();
            };
            const minus = document.createElement('button');
            minus.type = 'button';
            minus.className = 'btn set-adjust';
            minus.textContent = '−';
            minus.dataset.setAdjust = '-1';
            minus.disabled = item.sets <= 1;
            minus.setAttribute('aria-label', `Diminuer le nombre de séries de ${ex.name}`);
            minus.addEventListener('click', () => adjust(-1));
            const count = document.createElement('span');
            count.textContent = value!;
            const controls = document.createElement('span');
            controls.className = 'set-adjustment-buttons';
            const plus = document.createElement('button');
            plus.type = 'button';
            plus.className = 'btn set-adjust';
            plus.textContent = '+';
            plus.dataset.setAdjust = '1';
            plus.disabled = item.sets >= 10;
            plus.setAttribute('aria-label', `Augmenter le nombre de séries de ${ex.name}`);
            plus.addEventListener('click', () => adjust(1));
            controls.append(minus, plus);
            dd.append(count, controls);
          } else {
            dd.textContent = value!;
            if (unit) { const small = document.createElement('small'); small.textContent = unit; dd.append(small); }
          }
          box.append(dt, dd);
          dl.append(box);
        }

        const tips = document.createElement('ul');
        tips.className = 'mt-3 space-y-1 pl-5 list-disc';
        const tipsTitle = document.createElement('p');
        tipsTitle.className = 'mt-3 mb-0 font-bold';
        tipsTitle.textContent = 'À retenir (posture et sécurité) :';
        for (const t of ex.safetyTips.slice(0, 2)) {
          const tip = document.createElement('li');
          tip.textContent = t;
          tips.append(tip);
        }

        const total = item.sets;
        const isBodyweight = ex.equipment === 'Poids du corps';
        const lastLoad = (load<Record<string, number>>(KEY_LOADS) ?? {})[ex.id];
        const setCount = () => state?.sets?.[index] ?? 0;

        const track = document.createElement('div');
        track.className = 'ex-track';
        const dots = document.createElement('div');
        dots.className = 'set-dots';
        dots.setAttribute('role', 'img');
        const dotEls: HTMLSpanElement[] = [];
        for (let n = 0; n < total; n++) {
          const d = document.createElement('span');
          d.className = 'set-dot';
          dotEls.push(d);
          dots.append(d);
        }
        track.append(dots);

        let weightInput: HTMLInputElement | null = null;
        let saveWeight = () => {};
        if (!isBodyweight) {
          const wl = document.createElement('label');
          wl.className = 'weight-field';
          const wt = document.createElement('span');
          wt.textContent = lastLoad != null ? `Charge (kg) · dernière fois : ${lastLoad}` : 'Charge (kg)';
          const wi = document.createElement('input');
          wi.type = 'number';
          wi.inputMode = 'decimal';
          wi.min = '0';
          wi.step = '0.5';
          wi.placeholder = '0';
          const current = state?.weights?.[index] ?? lastLoad;
          if (current != null) wi.value = String(current);
          weightInput = wi;
          saveWeight = () => {
            const v = parseFloat(wi.value.replace(',', '.'));
            if (!state) return;
            if (wi.value === '' || !Number.isFinite(v) || v < 0) {
              if (state.weights) delete state.weights[index];
              persist();
              return;
            }
            state.weights = state.weights ?? [];
            state.weights[index] = v;
            const loads = load<Record<string, number>>(KEY_LOADS) ?? {};
            loads[ex.id] = v;
            store(KEY_LOADS, loads);
            persist();
          };
          wi.addEventListener('change', saveWeight);
          wl.append(wt, wi);
        }

        const setInputs = document.createElement('div');
        setInputs.className = 'set-inputs';
        const repsLabel = document.createElement('label');
        repsLabel.className = 'weight-field';
        const repsText = document.createElement('span');
        repsText.textContent = 'Répétitions effectuées';
        const repsInput = document.createElement('input');
        repsInput.type = 'number';
        repsInput.inputMode = 'numeric';
        repsInput.min = '1';
        repsInput.max = '1000';
        repsInput.step = '1';
        repsInput.placeholder = 'ex. 10';
        repsInput.setAttribute('aria-label', `Répétitions effectuées pour ${ex.name}`);
        repsLabel.append(repsText, repsInput);
        setInputs.append(repsLabel);
        if (weightInput) setInputs.append(weightInput.parentElement!);
        track.append(setInputs);

        const saveSetDetail = (setIndex: number) => {
          if (!state) return;
          const detail: SetDetail = {};
          const reps = Number(repsInput.value);
          if (repsInput.value !== '' && Number.isInteger(reps) && reps > 0) detail.reps = reps;
          if (weightInput && weightInput.value !== '') {
            const weight = Number(weightInput.value.replace(',', '.'));
            if (Number.isFinite(weight) && weight >= 0) detail.weight = weight;
          }
          state.setDetails = state.setDetails ?? [];
          state.setDetails[index] = state.setDetails[index] ?? [];
          state.setDetails[index]![setIndex] = detail;
        };

        const setBtn = document.createElement('button');
        setBtn.type = 'button';
        setBtn.className = 'btn btn-primary set-btn';
        track.append(setBtn);

        const actions = document.createElement('div');
        actions.className = 'ex-actions';

        const doneLabel = document.createElement('label');
        doneLabel.className = 'done-toggle justify-center';
        const doneInput = document.createElement('input');
        doneInput.type = 'checkbox';
        doneInput.setAttribute('aria-label', `Exercice terminé : ${ex.name}`);
        const doneBox = document.createElement('span');
        doneBox.className = 'done-box';
        doneBox.innerHTML = icon('check', 20);
        doneLabel.append(doneInput, doneBox, document.createTextNode('Fait ✓'));

        const sync = () => {
          const c = setCount();
          const finished = c >= total;
          dotEls.forEach((d, i) => d.classList.toggle('on', i < c));
          dots.setAttribute('aria-label', `${c} série${c > 1 ? 's' : ''} faite${c > 1 ? 's' : ''} sur ${total}`);
          li.classList.toggle('is-done', finished);
          doneInput.checked = finished;
          setBtn.textContent = finished ? 'Exercice terminé ✓ (annuler)' : `Valider la série ${c + 1} sur ${total}`;
          updateProgress();
        };
        const setProgress = (count: number) => {
          if (!state) return;
          state.sets = state.sets ?? [];
          state.done = state.done ?? [];
          if (state.setDetails?.[index]) state.setDetails[index] = state.setDetails[index]!.slice(0, count);
          state.sets[index] = count;
          state.done[index] = count >= total;
          persist();
          sync();
        };
        setBtn.addEventListener('click', () => {
          const c = setCount();
          if (c >= total) { setProgress(0); return; }
          saveWeight();
          saveSetDetail(c);
          setProgress(c + 1);
          keepAwake();
          if (c + 1 < total) { startRest(item.restSeconds, ex.name); return; }
          stopRest();
          toast(allDone() ? 'Séance terminée, bravo !' : `Exercice terminé : ${ex.name}`);
          advanceFocus(index);
        });
        doneInput.addEventListener('change', () => {
          if (doneInput.checked) {
            saveWeight();
            for (let setIndex = setCount(); setIndex < total; setIndex++) saveSetDetail(setIndex);
          }
          setProgress(doneInput.checked ? total : 0);
          if (doneInput.checked) advanceFocus(index);
        });
        sync();
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-accent swap-btn min-h-14';
        btn.innerHTML = `${icon('refreshCw', 20)}<span>Machine prise / Remplacer</span>`;
        btn.setAttribute('aria-label', `Machine prise : remplacer « ${ex.name} » par un autre exercice pour les ${ex.primaryMuscle.toLowerCase()}`);
        btn.addEventListener('click', () => swap(index));
        btn.setAttribute('data-swap', '');
        actions.append(doneLabel, btn);
        // Aperçu du geste toujours visible, pour décider de garder ou de remplacer l'exercice.
        const preview = document.createElement('div');
        preview.className = 'ex-preview';
        preview.innerHTML = motionHtml(ex, { bodyMapInFallback: true });
        initMotion(preview);

        const peek = document.createElement('details');
        peek.className = 'cm-peek';
        const sum = document.createElement('summary');
        sum.textContent = 'Voir le muscle travaillé';
        const peekBody = document.createElement('div');
        peekBody.className = 'cm-peek-body';
        peekBody.style.gridTemplateColumns = '1fr';
        peekBody.innerHTML = bodyMapSvg(ex.primaryMuscle, ex.secondaryMuscles);
        peek.append(sum, peekBody);
        peek.addEventListener('toggle', () => {
          if (peek.open) openPeeks.add(index); else openPeeks.delete(index);
        });
        if (openPeeks.has(index)) peek.open = true;

        const body = document.createElement('div');
        body.className = 'ex-body';
        const info = document.createElement('div');
        info.className = 'ex-info';
        info.append(dl, track, tipsTitle, tips, ...(ex.images ? [peek] : []), actions);
        body.append(preview, info);
        li.append(head, body);
        list.append(li);
      });
      updateProgress();
      applyFocus();
      keepAwake();
    }

    const allDone = () => !!state && state.items.length > 0 && state.items.every((_, i) => state?.done?.[i]);

    function updateProgress() {
      if (!state) return;
      const n = state.items.length;
      const d = state.items.filter((_, i) => state?.done?.[i]).length;
      $('progress-text').textContent = `${d} sur ${n} exercices terminés`;
      $('progress-fill').style.width = `${n ? (d / n) * 100 : 0}%`;
      $('progress-bar').setAttribute('aria-valuenow', String(d));
      $('progress-bar').setAttribute('aria-valuemax', String(n));
    }

    let focusMode = load<boolean>(KEY_FOCUS) === true;
    let focusIdx = 0;
    function applyFocus() {
      if (!state) return;
      const n = state.items.length;
      focusIdx = Math.min(Math.max(focusIdx, 0), n - 1);
      $('focus-toggle').setAttribute('aria-pressed', String(focusMode));
      $('focus-toggle').textContent = focusMode ? 'Voir tous les exercices' : 'Un exercice à la fois';
      $('focus-nav').hidden = !focusMode;
      document.querySelectorAll<HTMLElement>('#cards > li').forEach((li, i) => { li.hidden = focusMode && i !== focusIdx; });
      $('f-pos').textContent = `Exercice ${focusIdx + 1} sur ${n}`;
      $<HTMLButtonElement>('f-prev').disabled = focusIdx === 0;
      $<HTMLButtonElement>('f-next').disabled = focusIdx >= n - 1;
    }
    function advanceFocus(from: number) {
      if (!focusMode || !state || from >= state.items.length - 1) return;
      setTimeout(() => {
        focusIdx = from + 1;
        applyFocus();
        $('progress-bar').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 700);
    }
    $('focus-toggle').addEventListener('click', () => {
      focusMode = !focusMode;
      store(KEY_FOCUS, focusMode);
      if (focusMode && state) {
        const first = state.items.findIndex((_, i) => !state?.done?.[i]);
        focusIdx = first === -1 ? 0 : first;
      }
      applyFocus();
    });
    $('f-prev').addEventListener('click', () => { focusIdx -= 1; applyFocus(); $('progress-bar').scrollIntoView({ block: 'start' }); });
    $('f-next').addEventListener('click', () => { focusIdx += 1; applyFocus(); $('progress-bar').scrollIntoView({ block: 'start' }); });

    let wake: WakeLockSentinel | null = null;
    async function keepAwake() {
      try {
        if (!('wakeLock' in navigator) || wake || document.visibilityState !== 'visible') return;
        wake = await navigator.wakeLock.request('screen');
        wake.addEventListener('release', () => { wake = null; });
      } catch { /* non pris en charge */ }
    }
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && !$('result').hidden) keepAwake(); });

    function persist() { if (state) store(KEY_CURRENT, state); }

    function swap(index: number) {
      if (!state) return;
      const previous = exercises.find((e) => e.id === state!.items[index]?.exerciseId);
      const next = replaceExercise(exercises, state.items, index, state.params, rng);
      if (!next) {
        $('live').textContent = 'Aucune alternative disponible avec ce matériel.';
        say('Aucune alternative disponible avec ce matériel pour ce muscle.');
        return;
      }
      const doSwap = () => {
        if (!state) return;
        state.items[index] = next;
        if (state.done) state.done[index] = false;
        if (state.sets) state.sets[index] = 0;
        if (state.weights) delete state.weights[index];
        if (state.setDetails) delete state.setDetails[index];
        persist();
        trackAnalytics('exercise_swap', [next.exerciseId]);
        render(index);
        const now = exercises.find((e) => e.id === next.exerciseId);
        $('live').textContent = `« ${previous?.name} » remplacé par « ${now?.name} » (${now?.primaryMuscle}).`;
        say('');
        toast(`Remplacé par : ${now?.name}`);
        document.querySelectorAll<HTMLButtonElement>('#cards [data-swap]')[index]?.focus({ preventScroll: true });
        const newCard = document.querySelectorAll<HTMLElement>('#cards > li')[index];
        if (newCard) {
          // Haut du bloc aligné sous les barres collantes (scroll-margin-top dans le CSS).
          newCard.scrollIntoView({
            block: 'start',
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      };
      const card = document.querySelectorAll<HTMLElement>('#cards > li')[index];
      if (card && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        card.style.transition = 'opacity 0.15s ease, transform 0.15s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.98)';
        setTimeout(doSwap, 160);
      } else doSwap();
    }

    let restEnd = 0;
    let restTick: ReturnType<typeof setInterval> | undefined;
    let audioCtx: AudioContext | undefined;
    function beep() {
      try {
        audioCtx = audioCtx ?? new AudioContext();
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.frequency.value = 880;
        g.gain.value = 0.2;
        o.connect(g).connect(audioCtx.destination);
        o.start();
        o.stop(audioCtx.currentTime + 0.4);
      } catch { /* son indisponible */ }
    }
    function paintRest() {
      const left = Math.max(0, Math.ceil((restEnd - Date.now()) / 1000));
      $('rt-time').textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
      if (left === 0) {
        clearInterval(restTick);
        $('rest-timer').classList.add('finished');
        $('rt-label').textContent = 'Repos terminé : c’est reparti !';
        $('live').textContent = 'Repos terminé.';
        beep();
        navigator.vibrate?.([200, 100, 200]);
      }
    }
    function startRest(seconds: number, name: string) {
      clearInterval(restTick);
      restEnd = Date.now() + seconds * 1000;
      const el = $('rest-timer');
      el.classList.remove('finished');
      el.classList.add('show');
      $('rt-label').textContent = `Repos : ${name}`;
      paintRest();
      restTick = setInterval(paintRest, 250);
    }
    $('rt-plus').addEventListener('click', () => {
      const el = $('rest-timer');
      if (el.classList.contains('finished')) { startRest(15, 'repos supplémentaire'); return; }
      restEnd += 15000;
      paintRest();
    });
    function stopRest() {
      clearInterval(restTick);
      $('rest-timer').classList.remove('show', 'finished');
    }
    $('rt-stop').addEventListener('click', stopRest);

    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function toast(text: string) {
      const el = $('toast');
      el.textContent = text;
      el.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
    }

    function generate(p: SessionParams) {
      const names = targetMuscles(zones, p.zones).map((slug) => musclesJson.muscles.find((m) => m.slug === slug)?.name ?? slug);
      const items = generateSession(exercises, names, p, rng);
      state = { params: p, items, createdAt: new Date().toISOString(), done: [], sets: [], weights: [] };
      focusIdx = 0;
      stopRest();
      openPeeks.clear();
      persist();
      trackAnalytics('session_generated', items.map((item) => item.exerciseId));
      say('');
      render();
      const heading = $('result-title');
      heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
      heading.focus({ preventScroll: true });
    }

    form.addEventListener('submit', (ev) => { ev.preventDefault(); generate(readParams()); });
    $('again').addEventListener('click', () => { say(''); $('result').hidden = true; form.scrollIntoView({ behavior: 'smooth' }); });

    $('copy').addEventListener('click', async () => {
      if (!state) return;
      const text = sessionToText(exercises, state.items, titleOf(state.params));
      try { await navigator.clipboard.writeText(text); say('Séance copiée. Vous pouvez la coller dans un message ou une note.'); }
      catch {
        const area = document.createElement('textarea');
        area.value = text; document.body.append(area); area.select();
        say(document.execCommand('copy') ? 'Séance copiée.' : 'Copie impossible : sélectionnez le texte manuellement.');
        area.remove();
      }
    });

    $('finish').addEventListener('click', async () => {
      if (!state) return;
      const done = state.items.filter((_, i) => (state?.sets?.[i] ?? 0) > 0 || state?.done?.[i]);
      if (done.length === 0) { say('Validez au moins une série avant de terminer la séance.'); return; }
      const entry: HistoryEntry = {
        id: `${state.createdAt}|${state.items.map((i) => i.exerciseId).join(',')}`,
        date: new Date().toISOString(),
        title: titleOf(state.params),
        items: state.items.flatMap((item, i) => {
          const ex = exercises.find((e) => e.id === item.exerciseId);
          const setsDone = state?.done?.[i] ? item.sets : (state?.sets?.[i] ?? 0);
          if (!ex || setsDone === 0) return [];
          const weight = state?.weights?.[i];
          const setDetails = state?.setDetails?.[i]?.slice(0, setsDone)
            .filter((detail): detail is SetDetail => detail !== undefined);
          return [{
            exerciseId: ex.id,
            name: ex.name,
            muscle: ex.primaryMuscle,
            sets: item.sets,
            setsDone,
            reps: item.reps,
            ...(weight !== undefined ? { weight } : {}),
            ...(setDetails?.length ? { setDetails } : {}),
          }];
        }),
      };
      const saved = (load<HistoryEntry[]>(KEY_HISTORY) ?? []).filter(isEntry);
      // Une même séance terminée deux fois remplace l'enregistrement précédent.
      if (!store(KEY_HISTORY, mergeEntries(saved, [entry]))) { say("Impossible d'enregistrer : le stockage du navigateur est indisponible."); return; }
      try { await navigator.storage?.persist?.(); } catch { /* facultatif */ }
      trackAnalytics('session_completed', entry.items.map((item) => item.exerciseId));
      stopRest();
      say('');
      $('msg').innerHTML = 'Séance ajoutée à votre historique. <a href="/historique/">Voir mon historique</a>';
      toast('Bravo, séance enregistrée !');
    });

    function renderSaved() {
      const saved = load<Saved[]>(KEY_SAVED) ?? [];
      $('saved-section').hidden = saved.length === 0;
      const ul = $('saved');
      ul.replaceChildren();
      for (const s of saved) {
        const li = document.createElement('li');
        li.className = 'card flex flex-wrap items-center justify-between gap-3';
        const p = document.createElement('p');
        p.className = 'm-0';
        const date = new Date(s.createdAt).toLocaleDateString('fr-FR', { dateStyle: 'long' });
        p.textContent = `${titleOf(s.params)} — ${date}`;
        const open = document.createElement('button');
        open.type = 'button'; open.className = 'btn'; open.textContent = 'Reprendre';
        open.setAttribute('aria-label', `Reprendre la séance enregistrée : ${titleOf(s.params)}`);
        open.addEventListener('click', () => {
          state = { ...s, params: { ...s.params, equipment: canonicalEquipmentMode(s.params.equipment) } };
          writeParams(state.params);
          persist();
          render();
          $('result-title').scrollIntoView({ behavior: 'smooth' });
        });
        const start = document.createElement('button');
        start.type = 'button'; start.className = 'btn btn-primary'; start.textContent = 'Relancer';
        start.setAttribute('aria-label', `Relancer une nouvelle séance : ${titleOf(s.params)}`);
        start.addEventListener('click', () => {
          state = restartTemplate(s);
          state.params.equipment = canonicalEquipmentMode(state.params.equipment);
          writeParams(state.params);
          persist();
          render();
          $('result-title').scrollIntoView({ behavior: 'smooth' });
          say('Nouvelle séance démarrée depuis votre modèle.');
        });
        const del = document.createElement('button');
        del.type = 'button'; del.className = 'btn'; del.textContent = 'Supprimer';
        del.setAttribute('aria-label', `Supprimer la séance : ${titleOf(s.params)}`);
        del.addEventListener('click', () => { store(KEY_SAVED, saved.filter((x) => x.id !== s.id)); renderSaved(); });
        li.append(p, open, start, del);
        ul.append(li);
      }
    }

    $('keep').addEventListener('click', () => {
      if (!state) return;
      const saved = load<Saved[]>(KEY_SAVED) ?? [];
      if (saved.length >= 10) {
        say('Vous avez déjà 10 modèles. Supprimez-en un avant d’enregistrer une autre séance.');
        return;
      }
      saved.unshift({ ...state, id: String(Date.now()) });
      if (store(KEY_SAVED, saved)) say('Séance enregistrée comme modèle sur cet appareil.');
      else say("Impossible d'enregistrer : le stockage du navigateur est indisponible.");
      renderSaved();
    });

    // Démarrage : paramètres d'URL (lien depuis l'accueil) ou reprise de la séance en cours.
    const qs = new URLSearchParams(location.search);
    const current = load<State>(KEY_CURRENT);
    const valid = (s: State | null): s is State => !!s && Array.isArray(s.items) && s.items.every((i) => exercises.some((e) => e.id === i.exerciseId));
    if (qs.get('auto') === '1') {
      const zoneSlugs = (qs.get('zones') ?? '').split(',').filter((z) => zones.some((zone) => zone.slug === z)).slice(0, 3);
      const p: SessionParams = {
        goal: (['sante', 'muscle', 'force'].includes(qs.get('goal') ?? '') ? qs.get('goal') : 'sante') as Goal,
        zones: zoneSlugs,
        equipment: canonicalEquipmentMode((['salle', 'maison', 'halteres', 'corps'].includes(qs.get('equipment') ?? '') ? qs.get('equipment') : 'salle') as EquipmentMode),
        duration: ([30, 45, 60].includes(Number(qs.get('duration'))) ? Number(qs.get('duration')) : 45) as Duration,
      };
      writeParams(p);
      generate(p);
    } else if (valid(current)) {
      state = { ...current, params: { ...current.params, equipment: canonicalEquipmentMode(current.params.equipment) } };
      focusIdx = Math.max(0, current.items.findIndex((_, i) => !current.done?.[i]));
      writeParams(state.params);
      render();
      say('Votre séance en cours a été retrouvée sur cet appareil.');
    } else {
      updateZoneState();
    }
    renderSaved();
  </script>
</Layout>
