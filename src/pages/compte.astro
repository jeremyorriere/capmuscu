---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import exercisesJson from '../data/exercises.json';
import legal from '../data/legal.json';

const exercises = exercisesJson.map(({ slug, name }) => ({ slug, name }));
---
<Layout
  title="Mon compte CapMuscu"
  description="Connectez-vous pour sauvegarder et synchroniser votre historique, vos modèles de séances et vos exercices favoris."
  noindex
>
  <Breadcrumb items={[{ name: 'Mon compte' }]} />
  <h1>Mon compte CapMuscu</h1>
  <p class="mt-3 max-w-3xl text-muted">
    Utilisez votre compte pour sauvegarder vos données d'entraînement et les retrouver sur un autre appareil.
    Vous pouvez continuer à utiliser CapMuscu sans compte.
  </p>

  <section id="signed-out" class="card mt-6 max-w-2xl" aria-labelledby="signin-title">
    <h2 id="signin-title">Se connecter ou créer un compte</h2>
    <form id="email-form" class="mt-4 grid gap-3">
      <label for="account-email" class="font-bold">Votre adresse email</label>
      <input id="account-email" class="field" type="email" autocomplete="email" required maxlength="254" />
      <button class="btn btn-primary justify-self-start" type="submit">Recevoir un lien de connexion</button>
    </form>
    <div class="my-4 flex items-center gap-3 text-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span>ou<span class="h-px flex-1 bg-line"></span></div>
    <button id="google-signin" class="btn" type="button">Continuer avec Google</button>
    <p class="mt-4 mb-0 text-sm text-muted">
      Le lien de connexion est envoyé par Firebase Authentication. Vos données d'entraînement ne sont sauvegardées
      dans le cloud que lorsque vous choisissez de les synchroniser.
    </p>
  </section>

  <section id="signed-in" class="mt-6 max-w-3xl" aria-labelledby="account-title" hidden>
    <div class="card">
      <h2 id="account-title">Votre compte</h2>
      <p class="mt-2">Connecté en tant que <strong id="account-identity"></strong></p>
      <p class="text-muted">
        La synchronisation fusionne les données de cet appareil avec la sauvegarde en ligne. Pour propager une
        suppression sur un autre appareil, remplacez d'abord la sauvegarde en ligne, puis restaurez-la sur cet autre
        appareil. La restauration remplace ses données locales.
      </p>
      <div class="flex flex-wrap gap-3">
        <button id="sync-merge" class="btn btn-primary" type="button">Fusionner et synchroniser</button>
        <button id="sync-replace-cloud" class="btn" type="button">Remplacer la sauvegarde en ligne</button>
        <button id="sync-restore" class="btn" type="button">Restaurer sur cet appareil</button>
      </div>
      <p id="account-status" class="mt-4 mb-0 font-bold" role="status" aria-live="polite"></p>
      <button id="signout" class="btn mt-4" type="button">Se déconnecter</button>
    </div>

    <section class="card mt-6" aria-labelledby="favorites-title">
      <h2 id="favorites-title">Mes exercices favoris</h2>
      <p id="favorites-empty" class="mt-2 text-muted">Aucun favori pour le moment. Ajoutez-en depuis une fiche ou une liste d'exercices.</p>
      <ul id="favorites-list" class="mt-3 grid gap-2 sm:grid-cols-2 list-none p-0"></ul>
    </section>
  </section>

  <p id="account-error" class="card mt-6 max-w-2xl text-muted" role="status" aria-live="polite" hidden>
    Impossible de démarrer la connexion Firebase. Vérifiez la configuration du projet Firebase et réessayez.
  </p>

  <p id="account-notice" class="mt-6 max-w-3xl text-sm text-muted">
    La sauvegarde en ligne est facultative. Vous pouvez exporter votre historique depuis
    <a class="link" href="/historique/">Mon historique</a>. Pour demander la suppression de votre compte et de ses données,
    contactez-nous par <a class="link" href={`mailto:${legal.contactEmail}`}>email</a>.
  </p>

  <script id="exercise-data" type="application/json" set:html={JSON.stringify(exercises).replace(/</g, '\\u003c')} />
  <script>
    import {
      GoogleAuthProvider,
      browserLocalPersistence,
      getRedirectResult,
      isSignInWithEmailLink,
      onAuthStateChanged,
      sendSignInLinkToEmail,
      setPersistence,
      signInWithEmailLink,
      signInWithRedirect,
      signOut,
      type User,
    } from 'firebase/auth';
    import { doc, getDoc, serverTimestamp, writeBatch } from 'firebase/firestore';
    import { auth, db } from '../lib/firebase';
    import { KEY_HISTORY, isEntry, mergeEntries } from '../lib/history';
    import type { HistoryEntry } from '../lib/history';
    import type { SavedSessionTemplate } from '../lib/session-templates';

    const KEY_TEMPLATES = 'capmuscu-seances-gardees';
    const KEY_FAVORITES = 'capmuscu-exercices-favoris';
    const BACKUP_CATEGORIES = ['history', 'templates', 'favorites'] as const;
    type BackupData = { history: HistoryEntry[]; templates: SavedSessionTemplate[]; favorites: string[] };
    const exerciseData: unknown = JSON.parse(document.querySelector('#exercise-data')?.textContent ?? '[]');
    if (!Array.isArray(exerciseData) || !exerciseData.every((exercise) => exercise
      && typeof exercise.slug === 'string' && typeof exercise.name === 'string')) {
      throw new Error('La liste des exercices est invalide.');
    }
    const exerciseNames = new Map<string, string>(exerciseData.map((exercise: { slug: string; name: string }) => [exercise.slug, exercise.name]));
    const emailForm = document.querySelector<HTMLFormElement>('#email-form');
    const status = document.querySelector<HTMLElement>('#account-status');
    const setStatus = (message: string) => { if (status) status.textContent = message; };

    function isTemplate(value: unknown): value is SavedSessionTemplate {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
      const template = value as Partial<SavedSessionTemplate>;
      const params = template.params as unknown;
      if (!params || typeof params !== 'object' || Array.isArray(params)) return false;
      const sessionParams = params as Record<string, unknown>;
      const validParams = ['sante', 'muscle', 'force'].includes(String(sessionParams.goal))
        && Array.isArray(sessionParams.zones) && sessionParams.zones.every((zone) => typeof zone === 'string')
        && ['salle', 'maison', 'halteres', 'corps'].includes(String(sessionParams.equipment))
        && [30, 45, 60].includes(Number(sessionParams.duration));
      return typeof template.id === 'string'
        && typeof template.createdAt === 'string'
        && validParams
        && Array.isArray(template.items)
        && template.items.every((item) => !!item
          && typeof item.exerciseId === 'string' && exerciseNames.has(item.exerciseId)
          && Number.isInteger(item.sets) && item.sets >= 1 && item.sets <= 10
          && typeof item.reps === 'string' && item.reps.length <= 100
          && Number.isFinite(item.restSeconds) && item.restSeconds >= 0 && item.restSeconds <= 1800);
    }

    function readLocal<T>(key: string, validate: (value: unknown) => value is T): T[] {
      const raw = localStorage.getItem(key);
      if (raw === null) return [];
      const value: unknown = JSON.parse(raw);
      if (!Array.isArray(value) || !value.every(validate)) throw new Error('Données locales invalides.');
      return value;
    }

    function readLocalData(): BackupData {
      return {
        history: readLocal(KEY_HISTORY, isEntry),
        templates: readLocal(KEY_TEMPLATES, isTemplate),
        favorites: readLocal(KEY_FAVORITES, (value): value is string => typeof value === 'string'),
      };
    }

    function validateRemote<T>(value: unknown, validate: (item: unknown) => item is T): T[] {
      if (!Array.isArray(value) || !value.every(validate)) throw new Error('La sauvegarde en ligne contient des données invalides.');
      return value;
    }

    async function readCloudData(user: User): Promise<BackupData> {
      const snapshots = await Promise.all(BACKUP_CATEGORIES.map((category) =>
        getDoc(doc(db, 'users', user.uid, 'backups', category))));
      const getData = (index: number): unknown => snapshots[index]?.exists() ? snapshots[index]!.data().data : [];
      return {
        history: validateRemote(getData(0), isEntry),
        templates: validateRemote(getData(1), isTemplate),
        favorites: validateRemote(getData(2), (value): value is string => typeof value === 'string'),
      };
    }

    function mergeById<T extends { id: string }>(local: T[], cloud: T[]): T[] {
      const combined = new Map<string, T>();
      for (const item of [...cloud, ...local]) combined.set(item.id, item);
      return [...combined.values()];
    }

    function writeLocalData(data: BackupData) {
      localStorage.setItem(KEY_HISTORY, JSON.stringify(data.history));
      localStorage.setItem(KEY_TEMPLATES, JSON.stringify(data.templates));
      localStorage.setItem(KEY_FAVORITES, JSON.stringify(data.favorites));
      window.dispatchEvent(new CustomEvent('capmuscu:favorites-changed'));
    }

    async function writeCloudData(user: User, data: BackupData) {
      const batch = writeBatch(db);
      for (const category of BACKUP_CATEGORIES) {
        const values = data[category];
        if (new TextEncoder().encode(JSON.stringify(values)).byteLength > 800_000) {
          throw new Error('La sauvegarde est trop volumineuse pour le stockage Firebase gratuit. Exportez votre historique et réduisez les données.');
        }
        batch.set(doc(db, 'users', user.uid, 'backups', category), {
          data: values,
          updatedAt: serverTimestamp(),
        });
      }
      await batch.commit();
    }

    function renderFavorites() {
      let favorites: string[] = [];
      try {
        favorites = readLocal(KEY_FAVORITES, (value): value is string => typeof value === 'string');
      } catch {
        setStatus('Les favoris de cet appareil sont illisibles. Ils n’ont pas été modifiés.');
        return;
      }
      const list = document.querySelector<HTMLUListElement>('#favorites-list');
      const empty = document.querySelector<HTMLElement>('#favorites-empty');
      if (!list || !empty) return;
      list.replaceChildren();
      empty.hidden = favorites.length > 0;
      for (const slug of favorites) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const name = exerciseNames.get(slug);
        if (name) {
          link.className = 'link min-h-12 flex items-center';
          link.href = `/exercices/${slug}/`;
          link.textContent = name;
          li.append(link);
        } else {
          link.textContent = `Exercice indisponible : ${slug}`;
          li.append(link);
        }
        list.append(li);
      }
    }

    function showUser(user: User | null) {
      const signedOut = document.querySelector<HTMLElement>('#signed-out');
      const signedIn = document.querySelector<HTMLElement>('#signed-in');
      const identity = document.querySelector<HTMLElement>('#account-identity');
      if (signedOut) signedOut.hidden = !!user;
      if (signedIn) signedIn.hidden = !user;
      if (identity) identity.textContent = user?.email ?? user?.displayName ?? 'Compte Google';
      if (user) renderFavorites();
    }

    const action = async (operation: () => Promise<void>) => {
      setStatus('Opération en cours…');
      for (const button of document.querySelectorAll<HTMLButtonElement>('#signed-in button')) button.disabled = true;
      try {
        await operation();
      } catch (error) {
        console.error('CapMuscu: Firebase account operation failed.', error);
        setStatus(error instanceof Error ? error.message : 'Opération impossible. Vérifiez votre connexion et réessayez.');
      } finally {
        for (const button of document.querySelectorAll<HTMLButtonElement>('#signed-in button')) button.disabled = false;
      }
    };

    function currentUser(): User {
      if (!auth.currentUser) throw new Error('Connectez-vous avant de continuer.');
      return auth.currentUser;
    }

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = document.querySelector<HTMLInputElement>('#account-email')?.value.trim();
      if (!email || !emailForm.reportValidity()) return;
      try {
        await setPersistence(auth, browserLocalPersistence);
        await sendSignInLinkToEmail(auth, email, {
          url: `${window.location.origin}/compte/`,
          handleCodeInApp: true,
        });
        localStorage.setItem('capmuscu-pending-signin-email', email);
        const message = document.querySelector<HTMLElement>('#account-error');
        if (message) {
          message.hidden = false;
          message.textContent = 'Lien envoyé. Ouvrez votre boîte mail sur cet appareil et cliquez sur le lien pour vous connecter.';
        }
      } catch (error) {
        console.error('CapMuscu: Firebase email sign-in failed.', error);
        const message = document.querySelector<HTMLElement>('#account-error');
        if (message) {
          message.hidden = false;
          message.textContent = 'Impossible d’envoyer le lien. Vérifiez que la connexion par lien email est activée dans Firebase Authentication.';
        }
      }
    });

    document.querySelector('#google-signin')?.addEventListener('click', async () => {
      try {
        await setPersistence(auth, browserLocalPersistence);
        await signInWithRedirect(auth, new GoogleAuthProvider());
      } catch (error) {
        console.error('CapMuscu: Firebase Google sign-in failed.', error);
        const message = document.querySelector<HTMLElement>('#account-error');
        if (message) {
          message.hidden = false;
          message.textContent = 'Impossible de démarrer Google. Vérifiez que le fournisseur Google est activé dans Firebase Authentication.';
        }
      }
    });

    document.querySelector('#signout')?.addEventListener('click', () => {
      void action(async () => { await signOut(auth); setStatus(''); });
    });

    document.querySelector('#sync-merge')?.addEventListener('click', () => {
      void action(async () => {
        const user = currentUser();
        const [local, cloud] = await Promise.all([Promise.resolve(readLocalData()), readCloudData(user)]);
        const merged: BackupData = {
          history: mergeEntries(local.history, cloud.history),
          templates: mergeById(local.templates, cloud.templates),
          favorites: [...new Set([...cloud.favorites, ...local.favorites])],
        };
        writeLocalData(merged);
        await writeCloudData(user, merged);
        renderFavorites();
        setStatus('Données locales et sauvegarde en ligne fusionnées. Vos données restent aussi disponibles sans connexion.');
      });
    });

    document.querySelector('#sync-replace-cloud')?.addEventListener('click', () => {
      void action(async () => {
        if (!confirm('Remplacer complètement la sauvegarde en ligne par les données de cet appareil ? Cette action supprime du cloud les données absentes de cet appareil.')) return;
        const local = readLocalData();
        await writeCloudData(currentUser(), local);
        setStatus('La sauvegarde en ligne a été remplacée par les données de cet appareil.');
      });
    });

    document.querySelector('#sync-restore')?.addEventListener('click', () => {
      void action(async () => {
        if (!confirm('Remplacer les données locales de cet appareil par la sauvegarde en ligne ? Exportez d’abord l’historique local si vous souhaitez le garder.')) return;
        const cloud = await readCloudData(currentUser());
        writeLocalData(cloud);
        renderFavorites();
        setStatus('Sauvegarde restaurée sur cet appareil.');
      });
    });

    window.addEventListener('capmuscu:favorites-changed', renderFavorites);

    async function initializeAccount() {
      try {
        await setPersistence(auth, browserLocalPersistence);
        await getRedirectResult(auth);
        if (isSignInWithEmailLink(auth, window.location.href)) {
          const email = localStorage.getItem('capmuscu-pending-signin-email')
            ?? window.prompt('Confirmez votre adresse email pour terminer la connexion.');
          if (!email) throw new Error('Saisissez la même adresse email que celle à laquelle le lien a été envoyé.');
          await signInWithEmailLink(auth, email, window.location.href);
          localStorage.removeItem('capmuscu-pending-signin-email');
          window.history.replaceState({}, document.title, '/compte/');
        }
        onAuthStateChanged(auth, showUser, (error) => {
          console.error('CapMuscu: Firebase auth state failed.', error);
          const message = document.querySelector<HTMLElement>('#account-error');
          if (message) {
            message.hidden = false;
            message.textContent = 'Impossible de vérifier la connexion. Réessayez ou contactez-nous si le problème persiste.';
          }
        });
      } catch (error) {
        console.error('CapMuscu: Firebase initialization failed.', error);
        const message = document.querySelector<HTMLElement>('#account-error');
        if (message) {
          message.hidden = false;
          message.textContent = error instanceof Error ? error.message : 'Connexion Firebase indisponible.';
        }
      }
    }

    void initializeAccount();
  </script>
</Layout>
