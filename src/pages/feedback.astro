---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import legal from '../data/legal.json';
---
<Layout
  title="Donner votre avis"
  description="Une idée, un problème ou une correction à signaler ? Envoyez un retour à l'équipe CapMuscu."
>
  <Breadcrumb items={[{ name: 'Votre avis' }]} />
  <h1>Votre avis nous aide à progresser</h1>
  <p class="mt-3 max-w-3xl text-muted">
    Une idée de fonctionnalité, un exercice à corriger, un problème d'accessibilité ou un bug ?
    Dites-nous ce qui vous aiderait vraiment.
  </p>

  <form id="feedback-form" class="card mt-6 grid max-w-3xl gap-4" data-recipient={legal.contactEmail}>
    <div>
      <label class="font-bold" for="feedback-type">Quel type de retour souhaitez-vous faire ?</label>
      <select class="field mt-1" id="feedback-type" name="type">
        <option>Idée ou fonctionnalité</option>
        <option>Bug ou difficulté d'utilisation</option>
        <option>Correction d'un exercice ou d'une information</option>
        <option>Accessibilité</option>
        <option>Autre</option>
      </select>
    </div>
    <div>
      <label class="font-bold" for="feedback-message">Votre message</label>
      <textarea class="field mt-1 min-h-36" id="feedback-message" name="message" rows="6" required maxlength="5000"></textarea>
    </div>
    <div>
      <label class="font-bold" for="feedback-email">Votre email (facultatif, si vous souhaitez une réponse)</label>
      <input class="field mt-1" id="feedback-email" name="email" type="email" autocomplete="email" />
    </div>
    <p class="m-0 text-sm text-muted">
      Le bouton prépare un email dans votre application de messagerie. Rien n'est envoyé par le site :
      vous pourrez relire et envoyer le message vous-même. Évitez d'y inclure des informations de santé ou d'autres
      données sensibles.
    </p>
    <button class="btn btn-primary justify-self-start" type="submit">Préparer mon email</button>
    <p id="feedback-status" class="m-0 text-sm text-muted" role="status" aria-live="polite"></p>
  </form>

  <p class="mt-6 text-sm text-muted">
    Vous pouvez aussi écrire directement à <a class="link" href={`mailto:${legal.contactEmail}`}>{legal.contactEmail}</a>.
    Consultez notre <a class="link" href="/confidentialite/">politique de confidentialité</a>.
  </p>

  <script>
    const form = document.querySelector<HTMLFormElement>('#feedback-form');
    const status = document.querySelector<HTMLElement>('#feedback-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const subject = `[CapMuscu] ${String(data.get('type'))}`;
      const referrer = new URL(document.referrer || window.location.href);
      const page = referrer.origin === window.location.origin ? referrer.pathname : window.location.pathname;
      const body = [
        `Type : ${String(data.get('type'))}`,
        `Page concernée : ${page}`,
        '',
        String(data.get('message')),
        '',
        data.get('email') ? `Email pour répondre : ${String(data.get('email'))}` : '',
      ].filter(Boolean).join('\n');

      window.location.href = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = 'Votre application de messagerie devrait s’ouvrir. Le message ne partira qu’après votre envoi.';
    });
  </script>
</Layout>
