---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '../styles/global.css';
import { news, formatDateFr } from '../lib/data';
import { icon } from '../lib/icons';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  analyticsExerciseId?: string;
}
const { title, description, jsonLd = [], noindex = false, analyticsExerciseId } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/og-capmuscu.png', Astro.site).href;
const fullTitle = title.includes('CapMuscu') ? title : `${title} | CapMuscu`;
const path = Astro.url.pathname;
const nav: { href: string; label: string; short: string; icon: IconName; match: (p: string) => boolean }[] = [
  { href: '/', label: 'Accueil', short: 'Accueil', icon: 'house', match: (p) => p === '/' },
  { href: '/seance/', label: 'Créer ma séance', short: 'Ma séance', icon: 'listChecks', match: (p) => p.startsWith('/seance') },
  { href: '/exercices/', label: 'Exercices', short: 'Exercices', icon: 'dumbbell', match: (p) => p.startsWith('/exercices') || p.startsWith('/muscles') },
  { href: '/outils/', label: 'Outils', short: 'Outils', icon: 'calculator', match: (p) => p.startsWith('/outils') },
];
---
<!doctype html>
<html lang="fr" data-analytics-exercise={analyticsExerciseId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1D4ED8" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CapMuscu" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CapMuscu — séances, exercices et suivi de progression" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="CapMuscu — séances, exercices et suivi de progression" />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <script is:inline>
      try {
        var t = localStorage.getItem('capmuscu-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
        var textSize = localStorage.getItem('capmuscu-text-size');
        if (textSize === 'large' || textSize === 'larger') document.documentElement.dataset.textSize = textSize;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col pb-24 md:pb-0">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn btn-primary">Aller au contenu</a>
    <header class="site-header">
      <div class="mx-auto max-w-5xl px-4 py-2.5 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 text-xl font-extrabold text-ink no-underline" style="font-family: var(--font-display)" aria-label="CapMuscu, retour à l'accueil">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          CapMuscu
        </a>
        <nav aria-label="Navigation principale" class="hidden md:block">
          <ul class="flex gap-1 list-none p-0 m-0">
            {nav.map((n) => (
              <li>
                <a href={n.href} class="nav-link" aria-current={n.match(path) ? 'page' : undefined}>
                  <Fragment set:html={icon(n.icon, 20)} />{n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" id="theme-toggle" class="btn" aria-pressed="false">
          <span aria-hidden="true">🌙</span>
          <span id="theme-label">Mode sombre</span>
        </button>
      </div>
    </header>

    <main id="contenu" class="flex-1 mx-auto w-full max-w-5xl px-4 py-6 md:py-10">
      <slot />
    </main>

    <footer class="site-footer border-t border-line bg-card">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-muted grid gap-6 md:grid-cols-[minmax(14rem,1fr)_2fr]">
        <div class="space-y-2">
          <p class="m-0 text-base text-ink font-extrabold" style="font-family: var(--font-display)">CapMuscu</p>
          <p class="m-0">Musculation gratuite, sans publicité ni compte. Vos séances restent sur votre appareil.</p>
          <div class="flex flex-wrap items-center gap-2 pt-2" role="group" aria-label="Taille du texte">
            <span class="font-bold text-ink">Taille du texte :</span>
            <button type="button" class="btn text-size-button" data-text-size="normal" aria-label="Taille normale" aria-pressed="true">A</button>
            <button type="button" class="btn text-size-button" data-text-size="large" aria-label="Texte plus grand" aria-pressed="false">A+</button>
            <button type="button" class="btn text-size-button" data-text-size="larger" aria-label="Texte très grand" aria-pressed="false">A++</button>
          </div>
          <p class="m-0 text-xs">
            Conseils généraux : ils ne remplacent pas l'avis d'un médecin ou d'un coach diplômé. En cas de douleur ou de doute, demandez conseil.
          </p>
          <p class="m-0 text-xs">Actualités vérifiées le {formatDateFr(news.updatedAt)}.</p>
        </div>
        <nav aria-label="Liens du pied de page" class="grid gap-5 sm:grid-cols-3">
          <div>
            <h2 class="m-0 text-sm font-extrabold text-ink">Explorer</h2>
            <ul class="mt-2 grid grid-cols-2 gap-x-3 list-none p-0">
              <li><a href="/" class="min-h-11 flex items-center">Accueil</a></li>
              <li><a href="/exercices/" class="min-h-11 flex items-center">Exercices</a></li>
              <li><a href="/materiel/" class="min-h-11 flex items-center">Par matériel</a></li>
            </ul>
          </div>
          <div>
            <h2 class="m-0 text-sm font-extrabold text-ink">S'entraîner</h2>
            <ul class="mt-2 grid grid-cols-2 gap-x-3 list-none p-0">
              <li><a href="/seance/" class="min-h-11 flex items-center font-bold">Créer ma séance</a></li>
              <li><a href="/programmes/" class="min-h-11 flex items-center">Programmes guidés</a></li>
              <li><a href="/objectifs/" class="min-h-11 flex items-center">Mes objectifs</a></li>
              <li><a href="/historique/" class="min-h-11 flex items-center">Mon historique</a></li>
              <li><a href="/outils/" class="min-h-11 flex items-center">Outils</a></li>
              <li><a href="/compte/" class="min-h-11 flex items-center">Mon compte et favoris</a></li>
              <li><a href="/favoris/" class="min-h-11 flex items-center">Mes favoris</a></li>
              <li><a href="/installer/" class="min-h-11 flex items-center">Installer l'app</a></li>
            </ul>
          </div>
          <div>
            <h2 class="m-0 text-sm font-extrabold text-ink">À propos</h2>
            <ul class="mt-2 grid grid-cols-2 gap-x-3 list-none p-0">
              <li><a href="/feedback/" class="min-h-11 flex items-center">Donner mon avis</a></li>
              <li><a href="/mentions-legales/" class="min-h-11 flex items-center">Mentions légales</a></li>
              <li><a href="/confidentialite/" class="min-h-11 flex items-center">Confidentialité</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <p class="mx-auto max-w-5xl px-4 pb-5 text-xs text-muted m-0">© {new Date().getFullYear()} CapMuscu — capmuscu.fr</p>
    </footer>

    <AnalyticsConsent />

    <nav class="bottom-nav md:hidden" aria-label="Navigation mobile">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} class="tab" aria-current={n.match(path) ? 'page' : undefined}>
              <Fragment set:html={icon(n.icon, 26)} />
              <span>{n.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <script>
      import '../lib/motion-client';
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const label = document.getElementById('theme-label');
      const sync = () => {
        const dark = root.classList.contains('dark');
        btn?.setAttribute('aria-pressed', String(dark));
        if (label) label.textContent = dark ? 'Mode clair' : 'Mode sombre';
        const icon = btn?.querySelector('span[aria-hidden]');
        if (icon) icon.textContent = dark ? '☀️' : '🌙';
      };
      sync();
      btn?.addEventListener('click', () => {
        root.classList.toggle('dark');
        try { localStorage.setItem('capmuscu-theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch {}
        sync();
      });

      const textSizeButtons = [...document.querySelectorAll<HTMLButtonElement>('.text-size-button')];
      const syncTextSize = () => {
        const size = root.dataset.textSize ?? 'normal';
        textSizeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.textSize === size)));
      };
      syncTextSize();
      textSizeButtons.forEach((button) => button.addEventListener('click', () => {
        const size = button.dataset.textSize ?? 'normal';
        if (size === 'normal') delete root.dataset.textSize;
        else root.dataset.textSize = size;
        try {
          if (size === 'normal') localStorage.removeItem('capmuscu-text-size');
          else localStorage.setItem('capmuscu-text-size', size);
        } catch {}
        syncTextSize();
      }));
    </script>
  </body>
</html>
