---
import Breadcrumb from './Breadcrumb.astro';
import ExerciseCard from './ExerciseCard.astro';
import { exercises, muscles, equipmentList, difficulties, getCombos, muscleByName, zones } from '../lib/data';
import { EXERCISE_PAGE_SIZE, getExercisePage } from '../lib/exercise-directory';
import type { ExerciseSearchItem } from '../lib/exercise-directory';

interface Props { currentPage?: number }
const { currentPage = 1 } = Astro.props;
const sorted = [...exercises].sort((a, b) => a.name.localeCompare(b.name, 'fr'));
const { items, pageCount } = getExercisePage(sorted, currentPage);
const combos = getCombos();
const searchable: ExerciseSearchItem[] = sorted.map((exercise) => ({
  slug: exercise.slug,
  name: exercise.name,
  description: exercise.description.split('. ')[0]!.replace(/\.$/, ''),
  muscle: exercise.primaryMuscle,
  zone: zones.find((zone) => zone.muscles.includes(muscleByName(exercise.primaryMuscle)?.slug ?? ''))?.slug ?? '',
  equipment: exercise.equipment,
  difficulty: exercise.difficulty,
}));
const zoneList = zones.map(({ slug, name }) => ({ slug, name }));
const pageHref = (page: number) => page === 1 ? '/exercices/' : `/exercices/page/${page}/`;
const searchData = JSON.stringify(searchable).replace(/</g, '\\u003c');
const zoneData = JSON.stringify(zoneList).replace(/</g, '\\u003c');
---
<Breadcrumb items={[{ name: 'Exercices' }]} />
<h1>Encyclopédie des exercices</h1>
<p class="mt-3"><a class="btn" href="/materiel/">Trouver un exercice selon mon matériel</a></p>

<form class="card mt-6 grid gap-4 md:grid-cols-4" role="search" aria-label="Rechercher un exercice" onsubmit="return false">
  <div class="md:col-span-4">
    <label for="q" class="font-bold block mb-1">Rechercher un exercice</label>
    <input id="q" type="search" class="field" placeholder="Ex. : squat, pompes, tirage…" autocomplete="off" />
  </div>
  <div>
    <label for="f-muscle" class="font-bold block mb-1">Muscle</label>
    <select id="f-muscle" class="field">
      <option value="">Tous les muscles</option>
      {muscles.map((muscle) => <option value={muscle.name}>{muscle.name}</option>)}
    </select>
  </div>
  <div>
    <label for="f-equip" class="font-bold block mb-1">Matériel</label>
    <select id="f-equip" class="field">
      <option value="">Tout le matériel</option>
      {equipmentList.map((equipment) => <option value={equipment.label}>{equipment.label}</option>)}
    </select>
  </div>
  <div>
    <label for="f-level" class="font-bold block mb-1">Niveau</label>
    <select id="f-level" class="field">
      <option value="">Tous les niveaux</option>
      {difficulties.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}
    </select>
  </div>
  <div class="flex items-end">
    <button type="reset" id="reset" class="btn w-full">Tout effacer</button>
  </div>
</form>

<p id="count" class="mt-4 font-bold" role="status" aria-live="polite">
  {pageCount > 1
    ? `Affichage des exercices ${(currentPage - 1) * EXERCISE_PAGE_SIZE + 1} à ${Math.min(currentPage * EXERCISE_PAGE_SIZE, exercises.length)} sur ${exercises.length}`
    : `${exercises.length} exercices`}
</p>
<p id="empty" class="card mt-4" hidden>Aucun exercice ne correspond. Essayez d'élargir votre recherche.</p>

<ul id="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 mt-4">
  {items.map((exercise) => <li><ExerciseCard exercise={exercise} /></li>)}
</ul>
<script id="exercise-search-data" type="application/json" set:html={searchData}></script>
<script id="exercise-zone-data" type="application/json" set:html={zoneData}></script>

<nav id="pagination" data-current-page={currentPage} class="mt-6 flex flex-wrap items-center justify-between gap-3" aria-label="Pages des exercices">
  {currentPage > 1
    ? <a class="btn" rel="prev" href={pageHref(currentPage - 1)}>← Page précédente</a>
    : <span aria-hidden="true"></span>}
  <p class="m-0 text-sm text-muted" aria-current="page">Page {currentPage} sur {pageCount}</p>
  {currentPage < pageCount
    ? <a class="btn btn-primary" rel="next" href={pageHref(currentPage + 1)}>Page suivante →</a>
    : <span aria-hidden="true"></span>}
</nav>

<section class="mt-12" aria-labelledby="par-muscle">
  <h2 id="par-muscle">Explorer par muscle et matériel</h2>
  <ul class="mt-4 grid gap-2 sm:grid-cols-2 list-none p-0">
    {muscles.map((muscle) => <li><a class="link min-h-12 flex items-center" href={`/muscles/${muscle.slug}/`}>Exercices pour les {muscle.name.toLowerCase()}</a></li>)}
    {combos.map((combo) => <li><a class="link min-h-12 flex items-center" href={`/exercices/${combo.slug}/`}>{combo.muscle.name} {combo.equipment.phrase}</a></li>)}
  </ul>
</section>

<script>
  import { filterExerciseIndex, EXERCISE_PAGE_SIZE } from '../lib/exercise-directory';
  import type { ExerciseSearchItem } from '../lib/exercise-directory';
  const searchDataElement = document.getElementById('exercise-search-data');
  const zoneDataElement = document.getElementById('exercise-zone-data');
  const pagination = document.getElementById('pagination');
  if (!searchDataElement?.textContent || !zoneDataElement?.textContent || !(pagination instanceof HTMLElement)) {
    throw new Error('Données de l’encyclopédie manquantes.');
  }
  const paginationElement = pagination;
  const searchable: ExerciseSearchItem[] = JSON.parse(searchDataElement.textContent);
  const zoneList: { slug: string; name: string }[] = JSON.parse(zoneDataElement.textContent);
  const currentPage = Number(pagination.dataset.currentPage);
  const pageSize = EXERCISE_PAGE_SIZE;
  const q = document.getElementById('q');
  const fm = document.getElementById('f-muscle');
  const fe = document.getElementById('f-equip');
  const fl = document.getElementById('f-level');
  const list = document.getElementById('list');
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const reset = document.getElementById('reset');
  if (!(q instanceof HTMLInputElement) || !(fm instanceof HTMLSelectElement) || !(fe instanceof HTMLSelectElement) ||
      !(fl instanceof HTMLSelectElement) || !(list instanceof HTMLUListElement) || !(count instanceof HTMLParagraphElement) ||
      !(empty instanceof HTMLParagraphElement) || !(reset instanceof HTMLButtonElement)) {
    throw new Error('Contrôles de recherche de l’encyclopédie manquants.');
  }
  const searchInput = q as HTMLInputElement;
  const muscleFilter = fm as HTMLSelectElement;
  const equipmentFilter = fe as HTMLSelectElement;
  const levelFilter = fl as HTMLSelectElement;
  const exerciseList = list as HTMLUListElement;
  const resultCount = count as HTMLParagraphElement;
  const emptyMessage = empty as HTMLParagraphElement;
  const resetButton = reset as HTMLButtonElement;
  const initialCards = [...exerciseList.children].map((item) => item.cloneNode(true));
  const params = new URLSearchParams(location.search);
  let zoneParam = params.get('zone') || '';
  let offset = 0;
  paginationElement.dataset.currentPage = String(currentPage);
  const queryActive = () => Boolean(searchInput.value.trim() || muscleFilter.value || equipmentFilter.value || levelFilter.value || zoneParam);

  const muscleParam = params.get('muscle');
  if (muscleParam) muscleFilter.value = muscleParam;

  function apply() {
    if (!queryActive()) {
      exerciseList.replaceChildren(...initialCards.map((item) => item.cloneNode(true)));
      resultCount.textContent = `Affichage des exercices ${((currentPage - 1) * pageSize) + 1} à ${Math.min(currentPage * pageSize, searchable.length)} sur ${searchable.length}`;
      emptyMessage.hidden = true;
      paginationElement.hidden = false;
      const more = document.getElementById('show-more');
      if (more) more.hidden = true;
      return;
    }

    const matches = filterExerciseIndex(searchable, {
      query: searchInput.value,
      muscle: muscleFilter.value,
      equipment: equipmentFilter.value,
      difficulty: levelFilter.value,
      zone: zoneParam,
    });
    const visible = matches.slice(0, offset + pageSize);
    exerciseList.replaceChildren(...visible.map((exercise) => {
      const item = document.createElement('li');
      const card = document.createElement('article');
      card.className = 'card flex flex-col gap-3';
      const heading = document.createElement('h2');
      heading.className = 'text-xl';
      const link = document.createElement('a');
      link.href = `/exercices/${exercise.slug}/`;
      link.className = 'text-ink no-underline hover:underline';
      link.textContent = exercise.name;
      heading.append(link);
      const description = document.createElement('p');
      description.className = 'text-muted m-0';
      description.textContent = `${exercise.description}.`;
      const tags = document.createElement('p');
      tags.className = 'm-0 text-sm text-muted';
      tags.textContent = `${exercise.muscle} · ${exercise.equipment} · ${exercise.difficulty}`;
      card.append(heading, description, tags);
      item.append(card);
      return item;
    }));

    const zone = zoneList.find((item) => item.slug === zoneParam);
    resultCount.textContent = `Affichage de ${visible.length} sur ${matches.length} exercice${matches.length > 1 ? 's' : ''}` + (zone ? ` — zone : ${zone.name}` : '');
    emptyMessage.hidden = matches.length !== 0;
    paginationElement.hidden = true;

    let more = document.getElementById('show-more') as HTMLButtonElement | null;
    if (visible.length < matches.length) {
      if (!more) {
        more = document.createElement('button');
        more.id = 'show-more';
        more.type = 'button';
        more.className = 'btn mt-4 w-full';
        more.addEventListener('click', () => { offset += pageSize; apply(); });
        exerciseList.after(more);
      }
      more.textContent = `Afficher ${Math.min(pageSize, matches.length - visible.length)} exercices de plus`;
      more.hidden = false;
    } else if (more) {
      more.hidden = true;
    }
  }

  for (const element of [searchInput, muscleFilter, equipmentFilter, levelFilter]) {
    element.addEventListener('input', () => { offset = 0; apply(); });
    element.addEventListener('change', () => { offset = 0; apply(); });
  }
  resetButton.addEventListener('click', () => setTimeout(() => {
    zoneParam = '';
    history.replaceState(null, '', location.pathname);
    offset = 0;
    apply();
  }, 0));
  if (queryActive()) apply();
</script>
