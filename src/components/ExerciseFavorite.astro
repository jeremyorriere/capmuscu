---
interface Props {
  slug: string;
  name: string;
}

const { slug, name } = Astro.props;
---
<button
  type="button"
  class="btn favorite-toggle"
  data-favorite-slug={slug}
  data-favorite-name={name}
  aria-pressed="false"
  aria-label={`Ajouter ${name} aux favoris`}
>
  <span aria-hidden="true">☆</span>
  <span class="favorite-label">Ajouter aux favoris</span>
</button>

<script>
  const FAVORITES_KEY = 'capmuscu-exercices-favoris';
  const readFavorites = (): string[] => {
    const raw = localStorage.getItem(FAVORITES_KEY);
    if (raw === null) return [];
    const value: unknown = JSON.parse(raw);
    if (!Array.isArray(value) || !value.every((item) => typeof item === 'string')) {
      throw new Error('Favoris locaux invalides.');
    }
    return value;
  };

  const updateFavoriteButtons = () => {
    try {
      const favorites = new Set(readFavorites());
      document.querySelectorAll<HTMLButtonElement>('.favorite-toggle').forEach((button) => {
        const active = favorites.has(button.dataset.favoriteSlug ?? '');
        button.disabled = false;
        button.setAttribute('aria-pressed', String(active));
        button.setAttribute('aria-label', `${active ? 'Retirer' : 'Ajouter'} ${button.dataset.favoriteName ?? 'cet exercice'} ${active ? 'des' : 'aux'} favoris`);
        const icon = button.querySelector<HTMLElement>('[aria-hidden]');
        const label = button.querySelector<HTMLElement>('.favorite-label');
        if (icon) icon.textContent = active ? '★' : '☆';
        if (label) label.textContent = active ? 'Dans mes favoris' : 'Ajouter aux favoris';
      });
    } catch {
      document.querySelectorAll<HTMLButtonElement>('.favorite-toggle').forEach((button) => {
        button.disabled = true;
        button.setAttribute('aria-label', 'Favoris indisponibles : vérifiez les données enregistrées sur cet appareil');
      });
    }
  };

  updateFavoriteButtons();
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.favorite-toggle');
    if (!button) return;
    const slug = button.dataset.favoriteSlug;
    if (!slug) return;
    try {
      const favorites = new Set(readFavorites());
      if (favorites.has(slug)) favorites.delete(slug);
      else favorites.add(slug);
      localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites]));
      updateFavoriteButtons();
      window.dispatchEvent(new CustomEvent('capmuscu:favorites-changed'));
    } catch {
      button.disabled = true;
      button.setAttribute('aria-label', 'Impossible d’enregistrer ce favori dans le navigateur');
    }
  });
</script>
